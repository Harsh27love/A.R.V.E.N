DATABASE_URL="file:./dev.db"
PORT=3001
HOST=127.0.0.1
# SYNO AI: OpenRouter only. Copy to private .env and set the key there.
# Empty key = local Demo Mode. Never use a VITE_ prefix for credentials.
OPENROUTER_API_KEY=
# Empty values use the public defaults below; put overrides only in private .env.
# Base URL default: https://openrouter.ai/api/v1
# Model default: nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
# Optional Twilio SMS adapter; deliberately disabled by default.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ENABLE_LIVE_SMS=false
